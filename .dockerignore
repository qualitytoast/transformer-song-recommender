data/
.venv/
venv/
.git/
.github/
runs/
tests/
__pycache__/
**/__pycache__/
training_log.txt
*.png

# Old-format root-level checkpoints (pre-bundle). This pattern matches root files
# only, so artifacts/weights.npz still gets in, which the serving Dockerfile needs.
*.npz
